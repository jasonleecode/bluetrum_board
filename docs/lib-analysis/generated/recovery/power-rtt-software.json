  "implemented": [
    "raw PWKEY/VUSB, live wake flags and non-destructive component-init boot snapshot",
    "masked input/pull-up/filter/wake configuration with readback",
    "explicit PWKEY/VUSB/both reset-on-wake shutdown; wake restarts ROM and RTT, never resumes old threads",
    "scheduler-locked active BT/audio/FM/USB/TF admission observers",
    "shared RTC mutex and bounded SRAM transfers; no new worker or dynamic allocation",
    "all pre-commit changes have attempted rollback with restore error reporting",
    "final rail-write timeout takes terminal watchdog reset; no return with uncertain rail state",
    "all terminal and IRQ-masked entry paths reside in SRAM",
    "RTC-second alignment and stopped-RTC rejection before sleep",
    "RTC-second hardware wake with Timer0 paused, bounded RTC read and tick compensation",
    "restore timer, LPM request and IRQ/wake policy before returning; no timer callbacks inside PM critical region"
  ],
  "not_implemented": [
    "automatic tickless/deep sleep or PLL shutdown/restart",
    "preserving Bluetooth links through system suspend",
    "RTC alarm wake scheduling or PWKEY key event stream",
    "automatic RT-Thread PM backend or idle-hook sleep"
  ],
  "hardware_pending": [
    "soft power-off, external PWKEY/VUSB reset-on-wake and RTC retention after rail removal",
    "power/current and external supply backfeed measurements",
    "deep sleep and active Bluetooth link retention"
  ],
